# Copy this file to config/app.properties and edit the values for your computer.
# Make sure MySQL Server is running and the cafeteria_db database exists.
db.url=jdbc:mysql://localhost:3306/cafeteria_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
db.password=YOUR_MYSQL_PASSWORD

cafeteria.name=Campus Cafe
currency.symbol=Rs.
tax.rate=0.05
